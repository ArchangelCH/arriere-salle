# Copier en .env (jamais versionné) et adapter. Toutes les lignes sont facultatives.

# Le pack de campagne (docs/campagne.md). Sans lui : la campagne d'exemple du dépôt.
# CAMPAGNE_DIR=../ma-campagne
# La bible de la campagne, en Markdown (onglet Bible, contexte de la rédaction). Sans elle : une bible vide.
# BIBLE_DIR=../ma-bible
# TZ=Europe/Paris

# Le compte principal des MJ : son identifiant (« mj » par défaut ; à choisir avant la première fiche, il ne change plus
# ensuite) et son nom affiché (« Le MJ » par défaut).
# ATELIER_MJ_PRINCIPAL=mj
# ATELIER_MJ_NOM=Camille

# Ports sur la machine, et l'adresse où ils écoutent : toutes les interfaces par défaut (pour la TV et les téléphones du
# réseau local) par défaut. Sur une machine joignable depuis Internet, mettre l'adresse du réseau local (ou 127.0.0.1
# derrière un tunnel) : sur le réseau local, l'atelier n'a pas de mot de passe.
# ATELIER_ADRESSE=192.168.1.10
# ATELIER_PORT=8323
# JOUEURS_ADRESSE=192.168.1.10
# JOUEURS_PORT=8324

# Adresses données aux joueurs et au MJ.
# LIEN_JOUEURS=https://joueurs.exemple.org
# LIEN_ATELIER=https://atelier.exemple.org

# Noms d'hôte acceptés par l'atelier, en plus de localhost et des adresses IP (protection contre le rebinding DNS).
# ATELIER_HOTES=mon-serveur.local
# Publier sur Internet (derrière un tunnel ou un proxy https) : la vue TV en lecture seule, et l'atelier entier derrière
# un mot de passe (outils/mot-de-passe.py). Laisser vide pour rester sur le réseau local.
# TABLE_PUBLIQUE=table.exemple.org
# ATELIER_PUBLIC=atelier.exemple.org

# Deuxième MJ : « strict » puis « ouvertes » (docs/fonctionnement.md).
# ATELIER_CLOISONNEMENT=strict
# ATELIER_INVITATIONS=ouvertes

# Coin des joueurs : noms d'hôte acceptés, et cookies sans « Secure » pour un coin servi en http hors de localhost.
# JOUEURS_HOTES=joueurs.exemple.org
# JOUEURS_COOKIE_SECURE=0
